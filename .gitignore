################################################################################
#
#   File patterns for git to ignore
#
################################################################################

# Compiled Python modules
*.pyc
*.pyo
*.pyd
*.so

# Temporary build files
build/*

# Compiled documentation
documentation/_build/*

# Examples
/examples/*
!/examples/drpmd/

# Direct-RPMD output directories (never commit trajectory data by accident)
/drpmd-results*/
*.mod

# Eclipse project files
.project
.pydevproject
.settings/*
